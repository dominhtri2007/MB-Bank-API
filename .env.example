# MBBank Payment Gateway — Configuration (.env)
# Điền đầy đủ thông tin bên dưới

# Cổng khởi chạy Server
PORT=3456

# Khóa API bí mật của bạn (dùng để xác thực API /api/history/:apiKey, v.v.)
# Hãy tạo một chuỗi ngẫu nhiên, bí mật và khó đoán
API_KEY=mbk_secret_key_change_me_123456

# Thông tin đăng nhập tài khoản MB Bank Internet Banking
MB_USERNAME=your_mbbank_username
MB_PASSWORD=your_mbbank_password
MB_ACCOUNT_NUMBER=your_mbbank_account_number

# Mã định danh ngân hàng Quân Đội (VietQR BIN)
MB_BIN=970422

# Bảo mật & Giới hạn Rate Limit
# Số lượng request tối đa trong 1 phút cho mỗi client
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Whitelist IP truy cập (tùy chọn, để trống nếu cho phép tất cả các IP)
# Ví dụ: ALLOWED_IPS=127.0.0.1,192.168.1.10
ALLOWED_IPS=

# Phiên đăng nhập MB Bank (Session keep-alive)
# Ping MBBank mỗi N mili-giây để giữ kết nối (mặc định 4 phút = 240000ms)
KEEP_ALIVE_INTERVAL=240000
MAX_PING_FAILURES=3

# Mức log (debug, info, warn, error)
LOG_LEVEL=info

# Khi được POS gọi polling mỗi 4 giây, 60 request/phút là đủ cho khoảng 4 QR đang chờ.
# Tăng hai giá trị dưới đây nếu có nhiều QR PENDING đồng thời.
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000

